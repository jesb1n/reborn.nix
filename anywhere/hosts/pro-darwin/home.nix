# hosts/pro-darwin/home.nix — home-manager user config for jesbin
{ config, lib, pkgs, ... }:

{
  home = {
    username = "jesbin";
    homeDirectory = lib.mkForce "/Users/jesbin";
    stateVersion = "24.05";
    sessionPath = [ "/opt/homebrew/bin" "/opt/homebrew/sbin" ];
  };

  programs = {
    zsh = {
      enable = true;
      autosuggestion.enable = true;
      syntaxHighlighting.enable = true;
      envExtra = ''
        export PATH="$HOME/.local/bin:$PATH"
        export PATH="$PATH:/Users/jesbin/Library/Python/3.9/bin"
      '';
      history = {
        size = 50000;
        save = 50000;
        ignoreDups = true;
        share = true;
      };
      shellAliases = {
        gs = "git status";
        gd = "git diff";
        gl = "git log --oneline -20";
        k = "kubectl";
        kx = "kubectx";
        # Occasional cask/formula refresh; greedy also covers self-updating casks.
        brewup = "brew update && brew upgrade --greedy";
      };
      initContent = ''
        # kubectl-aliases (https://github.com/ahmetb/kubectl-aliases)
        [ -f ~/.kubectl_aliases ] && source ~/.kubectl_aliases

        # oh-my-zsh git plugin aliases (https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/git)
        [ -f ~/.oh-my-zsh/plugins/git/git.plugin.zsh ] && source ~/.oh-my-zsh/plugins/git/git.plugin.zsh


        # gx: permanently switch gcloud project
        gx() {
          local project
          project=$(gcloud projects list --format='value(projectId)' 2>/dev/null | fzf --prompt='gcloud project> ')
          [ -z "$project" ] && return 0
          if gcloud config set project "$project" 2>/dev/null; then
            echo "Switched to project: $project"
          fi
        }

        # tgx: temporarily switch gcloud project for this shell session only
        tgx() {
          local project
          project=$(gcloud projects list --format='value(projectId)' 2>/dev/null | fzf --prompt='gcloud project (temp)> ')
          [ -z "$project" ] && return 0
          export CLOUDSDK_CORE_PROJECT="$project"
          echo "CLOUDSDK_CORE_PROJECT=$project (session only)"
        }
      '';
    };

    git = {
      enable = true;
      settings = {
        user.name = "jesbinjoseph";
        user.email = "jesbin.joseph@egovernments.org";
        init.defaultBranch = "main";
        pull.rebase = true;
        push.autoSetupRemote = true;
        # New clones/inits get the pre-commit hook (see .git-template below).
        init.templateDir = "${config.home.homeDirectory}/.git-template";
        core.pager = "delta";
        interactive.diffFilter = "delta --color-only";
      };
    };

    bat = {
      enable = true;
      config.theme = "TwoDark";
    };

    delta = {
      enable = true;
      options = {
        navigate = true;
        side-by-side = true;
        line-numbers = true;
      };
    };

    starship = {
      enable = true;
      settings = {
        add_newline = true;
        character = {
          success_symbol = "[❯](bold green)";
          error_symbol = "[❯](bold red)";
        };
      };
    };

    fzf = {
      enable = true;
      enableZshIntegration = true;
    };

    direnv = {
      enable = true;
      nix-direnv.enable = true;
      enableZshIntegration = true;
    };

    # SSH keys come from the 1Password agent (Settings → Developer → "Use the
    # SSH agent"). Key files in ~/.ssh still work as a fallback.
    ssh = {
      enable = true;
      enableDefaultConfig = false;
      settings."*".IdentityAgent =
        ''"~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"'';
    };

    jq.enable = true;
    htop.enable = true;
  };

  # Real app bundles in ~/Applications/Home Manager Apps so Spotlight/Launchpad
  # index them (replaces mac-app-util's trampolines).
  targets.darwin.linkApps.enable = false;
  targets.darwin.copyApps.enable = true;

  # Global pre-commit hook template, equivalent to `pre-commit init-templatedir`.
  # Repos without .pre-commit-config.yaml are skipped. Git copies template
  # files (symlinks included) into every new repo, so this must be a real file
  # that calls the stable per-user profile path — a home.file symlink or a
  # /nix/store path would dangle in each repo after GC.
  # Existing repos: run `git init` (safe) or `pre-commit install` once.
  home.activation.preCommitTemplate =
    let
      hook = pkgs.writeText "pre-commit-template-hook" ''
        #!/usr/bin/env bash
        # File generated by pre-commit: https://pre-commit.com
        # ID: 138fd403232d2ddd5efb44317e38bf03
        ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=pre-commit --skip-on-missing-config)
        HERE="$(cd "$(dirname "$0")" && pwd)"
        ARGS+=(--hook-dir "$HERE" -- "$@")
        exec /etc/profiles/per-user/${config.home.username}/bin/pre-commit "''${ARGS[@]}"
      '';
    in
    lib.hm.dag.entryAfter [ "writeBoundary" ] ''
      run install -D -m 0755 ${hook} "$HOME/.git-template/hooks/pre-commit"
    '';

  # Kubernetes MCP server (Homebrew formula): read-only, s145 cluster only.
  # It never falls back to ~/.kube/config, which holds the GKE work contexts.
  xdg.configFile."kubernetes-mcp-server/config.toml".text = ''
    kubeconfig = "${config.home.homeDirectory}/.kube/s145.yaml"
    read_only = true
    toolsets = ["core", "config", "helm"]
  '';

  # Target of system.defaults.screencapture.location.
  home.file."Pictures/Screenshots/.keep".text = "";

  home.packages = with pkgs; [
    fd
    ripgrep
    yq-go
    tree
    gh
    tmux
    pre-commit
    kubectl
    kubectx
    kubernetes-helm
    opencode
    cloudflared
    k9s
    code-cursor
    firefox
    slack
    google-cloud-sdk
    opentofu
    awscli2
    ssm-session-manager-plugin
    oci-cli
    sops
    iterm2
    ffmpeg
    k6
    _1password-cli
    github-mcp-server
    # GitHub MCP server for Claude Code. The token never touches disk: `op read`
    # fetches it from 1Password (Touch ID) at launch. Override the item with
    # GITHUB_MCP_OP_REF if it lives elsewhere.
    (writeShellApplication {
      name = "github-mcp";
      runtimeInputs = [ _1password-cli github-mcp-server ];
      text = ''
        ref="''${GITHUB_MCP_OP_REF:-op://Private/GitHub MCP/token}"
        GITHUB_PERSONAL_ACCESS_TOKEN="$(op read "$ref")"
        export GITHUB_PERSONAL_ACCESS_TOKEN
        exec github-mcp-server stdio "$@"
      '';
    })
  ];

  # iTerm2 Dynamic Profile — Dracula theme + JetBrains Mono
  home.file.".kubectl_aliases".source = builtins.fetchurl {
    # Pinned to a commit: a branch URL breaks the fixed hash whenever upstream changes.
    url = "https://raw.githubusercontent.com/ahmetb/kubectl-aliases/7549fa45bbde7499b927c74cae13bfb9169c9497/.kubectl_aliases";
    sha256 = "sha256:1acyhhhbfxz17ch77nf26x0cj4immsl6drcpwwbklrl49n9gm9ia";
  };

  # oh-my-zsh git plugin — lightweight, single file, no full framework
  home.file.".oh-my-zsh/plugins/git/git.plugin.zsh".source = builtins.fetchurl {
    url = "https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/083c339e0622bfc144b66ebf1a2e8dbe7d2ada0d/plugins/git/git.plugin.zsh";
    sha256 = "sha256:1l8kn2q9lc5jm552j08h821jyw4apysdywr30p2ganbq7dhnhig6";
  };

  home.file."Library/Application Support/iTerm2/DynamicProfiles/Nix.json".text = builtins.toJSON {
    Profiles = [
      {
        Name = "Nix";
        "Guid" = "nix-managed-pro-darwin";
        "Normal Font" = "JetBrainsMonoNerdFont-Regular 14";
        "Non Ascii Font" = "JetBrainsMonoNerdFont-Regular 14";
        "Horizontal Spacing" = 1.0;
        "Vertical Spacing" = 1.1;
        "Use Non-ASCII Font" = true;

        "Copy Selection" = true;
        "Silence Bell" = true;
        "Visual Bell" = false;
        "Flashing Bell" = false;
        "Blinking Cursor" = true;
        "Cursor Type" = 2;
        "ASCII Anti Aliased" = true;
        "Non Ascii Anti Aliased" = true;
        "Use Tabular Widths" = true;

        "Scrollback Lines" = 10000;

        "Background Color" = "#282A36FF";
        "Foreground Color" = "#F8F8F2FF";
        "Cursor Color" = "#F8F8F2FF";
        "Cursor Text Color" = "#282A36FF";
        "Selection Color" = "#44475AFF";
        "Selected Text Color" = "#F8F8F2FF";
        "Bold Color" = "#F8F8F2FF";
        "Link Color" = "#8BE9FDFF";

        "Ansi 0 Color" = "#21222CFF";
        "Ansi 1 Color" = "#FF5555FF";
        "Ansi 2 Color" = "#50FA7BFF";
        "Ansi 3 Color" = "#F1FA8CFF";
        "Ansi 4 Color" = "#BD93F9FF";
        "Ansi 5 Color" = "#FF79C6FF";
        "Ansi 6 Color" = "#8BE9FDFF";
        "Ansi 7 Color" = "#F8F8F2FF";
        "Ansi 8 Color" = "#6272A4FF";
        "Ansi 9 Color" = "#FF6E6EFF";
        "Ansi 10 Color" = "#69FF94FF";
        "Ansi 11 Color" = "#FFFFA5FF";
        "Ansi 12 Color" = "#D6ACFFFF";
        "Ansi 13 Color" = "#FF92DFFF";
        "Ansi 14 Color" = "#A4FFFFFF";
        "Ansi 15 Color" = "#FFFFFFFF";
      }
    ];
  };
}
